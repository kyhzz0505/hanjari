'use strict';
// 백엔드 주소만 이곳에서 관리합니다. Gemini 키는 프론트에 넣지 않습니다.
const API_BASE = 'http://localhost:8080';
const $ = (selector) => document.querySelector(selector);
const tabs = [$('#condition-tab'), $('#ai-tab')];
const status = $('#status');
let activeRequest = null;
let toastTimer;
let searchNoticeTimer;
function showSearchNotice(message) {
  clearTimeout(searchNoticeTimer);
  status.textContent = message;
  if (message) searchNoticeTimer = setTimeout(() => { status.textContent = ''; }, 4000);
}

// 브라우저 기본 선택창 대신 화면 디자인과 일치하는 아래쪽 메뉴를 사용합니다.
const dropdowns = [];
function createDropdown(name, choices) {
  const wrapper = document.querySelector(`[data-dropdown="${name}"]`);
  const trigger = wrapper.querySelector('.dropdown-trigger');
  const menu = wrapper.querySelector('.dropdown-menu');
  const list = wrapper.querySelector('[role="listbox"]');
  const input = document.getElementById(name);
  const valueLabel = document.getElementById(`${name}-value`);
  let active = Math.max(0, choices.findIndex(choice => choice.value === input.value));
  const options = choices.map((choice, index) => {
    const option = document.createElement('li');
    option.id = `${name}-option-${index}`;
    option.setAttribute('role', 'option');
    option.setAttribute('aria-selected', String(choice.value === input.value));
    option.textContent = choice.label;
    // 포인터 선택 시 combobox의 키보드 포커스를 유지합니다.
    option.addEventListener('pointerdown', event => event.preventDefault());
    option.addEventListener('click', () => choose(index));
    list.append(option);
    return option;
  });
  function highlight(index) {
    active = Math.max(0, Math.min(options.length - 1, index));
    options.forEach((option, i) => option.classList.toggle('is-active', i === active));
    trigger.setAttribute('aria-activedescendant', options[active].id);
    // 페이지 전체 대신 목록 안에서만 스크롤합니다.
    const option = options[active];
    if (option.offsetTop < list.scrollTop) list.scrollTop = option.offsetTop;
    else if (option.offsetTop + option.offsetHeight > list.scrollTop + list.clientHeight) {
      list.scrollTop = option.offsetTop + option.offsetHeight - list.clientHeight;
    }
  }
  function close() {
    menu.hidden = true;
    trigger.setAttribute('aria-expanded', 'false');
    trigger.removeAttribute('aria-activedescendant');
    wrapper.classList.remove('is-open');
  }
  function open() {
    dropdowns.forEach(dropdown => dropdown.close());
    menu.hidden = false;
    wrapper.classList.add('is-open');
    trigger.setAttribute('aria-expanded', 'true');
    highlight(choices.findIndex(choice => choice.value === input.value));
  }
  function choose(index) {
    input.value = choices[index].value;
    valueLabel.textContent = choices[index].label;
    options.forEach((option, i) => option.setAttribute('aria-selected', String(i === index)));
    input.dispatchEvent(new Event('change', { bubbles: true }));
    close();
    trigger.focus({ preventScroll: true });
  }
  trigger.addEventListener('click', () => menu.hidden ? open() : close());
  trigger.addEventListener('keydown', event => {
    if (event.key === 'Escape') { event.preventDefault(); close(); return; }
    if (event.key === 'Tab') { close(); return; }
    if (['ArrowDown', 'ArrowUp', 'Home', 'End'].includes(event.key)) {
      event.preventDefault();
      if (menu.hidden) {
        open();
        if (event.key === 'Home') highlight(0);
        if (event.key === 'End') highlight(options.length - 1);
      } else highlight(event.key === 'Home' ? 0 : event.key === 'End' ? options.length - 1 : active + (event.key === 'ArrowDown' ? 1 : -1));
    }
    if (event.key === 'Enter' || event.key === ' ') {
      event.preventDefault();
      if (menu.hidden) open(); else choose(active);
    }
  });
  wrapper.addEventListener('focusout', event => { if (!wrapper.contains(event.relatedTarget)) close(); });
  dropdowns.push({ wrapper, close });
}
createDropdown('district', [{ value: '마포구', label: '마포구' }]);
createDropdown('people', Array.from({ length: 20 }, (_, i) => ({ value: String(i + 1), label: `${i + 1}명` })));
document.addEventListener('pointerdown', event => {
  dropdowns.forEach(dropdown => { if (!dropdown.wrapper.contains(event.target)) dropdown.close(); });
});

function activateTab(index, focus = false) {
  dropdowns.forEach(dropdown => dropdown.close());
  tabs.forEach((tab, i) => {
    tab.setAttribute('aria-selected', String(i === index));
    tab.tabIndex = i === index ? 0 : -1;
    document.getElementById(tab.getAttribute('aria-controls')).hidden = i !== index;
  });
  if (focus) tabs[index].focus();
}
tabs.forEach((tab, i) => {
  tab.addEventListener('click', () => activateTab(i));
  tab.addEventListener('keydown', (event) => {
    if (['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) {
      event.preventDefault();
      activateTab(event.key === 'Home' ? 0 : event.key === 'End' ? 1 : 1 - i, true);
    }
  });
});
$('#nav-ai').addEventListener('click', () => {
  activateTab(1);
  $('#query').focus();
});
document.querySelectorAll('[data-notice]').forEach((button) => {
  button.addEventListener('click', () => {
    clearTimeout(toastTimer);
    $('#toast').textContent = button.dataset.notice;
    $('#toast').hidden = false;
    toastTimer = setTimeout(() => { $('#toast').hidden = true; }, 4000);
  });
});

async function request(path, options = {}) {
  const response = await fetch(API_BASE + path, options);
  const data = await response.json().catch(() => null);
  if (!response.ok) throw new Error(data?.message || `요청을 처리하지 못했어요. (${response.status})`);
  if (data === null) throw new Error('서버 응답을 확인할 수 없어요. 다시 시도해 주세요.');
  return data;
}
function node(tag, text, className) {
  const el = document.createElement(tag);
  if (text !== undefined) el.textContent = text;
  if (className) el.className = className;
  return el;
}
function photo(url, alt) {
  if (!url || !url.startsWith('/images/')) return node('div', '사진 준비 중', 'image-placeholder');
  const image = document.createElement('img');
  image.src = API_BASE + url;
  image.alt = alt;
  image.loading = 'lazy';
  image.addEventListener('error', () => image.replaceWith(node('div', '사진을 불러오지 못했어요', 'image-placeholder')), { once: true });
  return image;
}
function showResults(restaurants, conditions, message) {
  $('#results').hidden = false;
  $('#count').textContent = `${restaurants.length}곳`;
  $('#conditions').textContent = `검색 조건: ${conditions.district || '전체 지역'} · ${conditions.people ? conditions.people + '명' : '인원 상관없음'} · ${conditions.room ? '룸 필요' : '룸 상관없음'}`;
  $('#recommendation').hidden = !message;
  $('#recommendation').textContent = message || '';
  $('#cards').replaceChildren();
  restaurants.forEach((restaurant) => {
    const card = node('button', undefined, 'card');
    card.type = 'button';
    card.setAttribute('aria-label', `${restaurant.name} 좌석 상세 보기`);
    card.append(photo(restaurant.mainImageUrl, restaurant.name));
    const body = node('div', undefined, 'card-body');
    body.append(node('h3', restaurant.name), node('p', `${restaurant.district} · ${restaurant.category || '식당'}`), node('p', restaurant.address));
    body.append(node('span', restaurant.maxGroupCapacity == null ? '좌석 정보 없음' : `함께 최대 ${restaurant.maxGroupCapacity}명`, 'badge'));
    if (restaurant.hasRoom) body.append(node('span', '룸 보유', 'badge'));
    card.append(body);
    card.addEventListener('click', () => showDetail(restaurant.id));
    $('#cards').append(card);
  });
  showSearchNotice(restaurants.length ? '' : '조건에 맞는 식당이 없어요. 인원이나 룸 조건을 바꿔 다시 찾아보세요.');
}
async function search(isAi) {
  if (activeRequest) return;
  const query = $('#query').value.trim();
  if (isAi && !query) { showSearchNotice('검색 문장을 입력해 주세요.'); $('#query').focus(); return; }
  const controller = new AbortController();
  activeRequest = controller;
  const timeout = setTimeout(() => controller.abort(), 45000);
  const buttons = document.querySelectorAll('.submit');
  buttons.forEach(button => { button.disabled = true; });
  $('#search-panel').setAttribute('aria-busy', 'true');
  $('#results').hidden = true;
  showSearchNotice(isAi ? 'AI가 모임 조건과 좌석 정보를 확인하고 있어요. 잠시만 기다려 주세요.' : '함께 앉을 수 있는 식당을 찾고 있어요…');
  const conditions = { district: $('#district').value, people: Number($('#people').value), room: $('#room').checked };
  try {
    if (isAi) {
      const data = await request('/api/ai/search', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ query }), signal: controller.signal });
      showResults(data.restaurants, data.conditions, data.message);
    } else {
      const params = new URLSearchParams(conditions);
      const data = await request(`/api/restaurants?${params}`, { signal: controller.signal });
      showResults(data, conditions, null);
    }
  } catch (error) {
    showSearchNotice(error.name === 'AbortError' ? '응답이 지연되고 있어요. 잠시 후 다시 검색해 주세요.' : error instanceof TypeError ? '서버에 연결할 수 없어요. 백엔드를 실행하고 Live Server의 5500 포트에서 다시 시도해 주세요.' : error.message);
  } finally {
    clearTimeout(timeout);
    activeRequest = null;
    buttons.forEach(button => { button.disabled = false; });
    $('#search-panel').removeAttribute('aria-busy');
  }
}
$('#condition-form').addEventListener('submit', event => { event.preventDefault(); search(false); });
$('#ai-form').addEventListener('submit', event => { event.preventDefault(); search(true); });

const dialog = $('#detail-dialog');
let detailRequest;
$('#close-detail').addEventListener('click', () => dialog.close());
dialog.addEventListener('close', () => detailRequest?.abort());
async function showDetail(id) {
  detailRequest?.abort();
  const controller = new AbortController();
  detailRequest = controller;
  const timer = setTimeout(() => controller.abort(), 20000);
  const content = $('#detail-content');
  const heading = node('h2', '좌석 정보를 불러오고 있어요…');
  heading.id = 'detail-title';
  content.replaceChildren(heading);
  dialog.showModal();
  try {
    const data = await request(`/api/restaurants/${encodeURIComponent(id)}`, { signal: controller.signal });
    heading.textContent = data.name;
    content.append(node('p', data.address), node('p', `영업시간: ${data.businessHours || '정보 없음'}`), node('p', `전화: ${data.phone || '정보 없음'}`), node('p', `정보 확인일: ${data.lastVerifiedAt || '정보 없음'}`));
    content.append(node('h3', '좌석 구성'));
    const types = { TABLE: '일반 테이블', CONNECTED: '연결 단체석', ROOM: '룸' };
    if (!data.seatings.length) content.append(node('p', '등록된 좌석 정보가 없어요.'));
    data.seatings.forEach(seating => {
      const section = node('article');
      section.append(node('h4', `${seating.name} · ${types[seating.seatingType] || seating.seatingType}`), node('p', `${seating.minCapacity}~${seating.maxCapacity}명 · ${seating.quantity}개`));
      if (seating.description) section.append(node('p', seating.description));
      content.append(section);
    });
    const gallery = node('div', undefined, 'gallery');
    data.images.forEach(image => {
      const figure = node('figure');
      figure.append(photo(image.imageUrl, image.caption || data.name), node('figcaption', image.caption || '식당 사진'));
      gallery.append(figure);
    });
    content.append(gallery, node('p', '좌석 구성 안내이며 실시간 빈자리나 예약 가능 여부를 뜻하지 않습니다.'));
  } catch (error) {
    if (dialog.open) heading.textContent = error.name === 'AbortError' ? '응답이 지연되고 있어요. 닫은 뒤 다시 시도해 주세요.' : '상세 정보를 불러오지 못했어요. 잠시 후 다시 시도해 주세요.';
  } finally { clearTimeout(timer); }
}
